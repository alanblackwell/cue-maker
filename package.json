{
  "name": "cue-maker",
  "version": "0.2.0",
  "private": true,
  "description": "Rule-based film cue sketching and rendering in the browser",
  "type": "module",
  "scripts": {
    "start": "node serve.mjs",
    "test": "node --test test/*.test.js",
    "safari": "open -a Safari http://127.0.0.1:8000/",
    "chrome": "open -na 'Google Chrome' --args --user-data-dir=\"$(mktemp -d -t cue-maker-chrome)\" --no-first-run --no-default-browser-check http://127.0.0.1:8000/"
  }
}
